# Laptop measurement only (scripts/lite-measure.sh): lite compose under the local profile on LocalStack + Mailpit.
# Secrets come from the repo's .env (scripts/dev-env.sh); images are the locally built ones (tags, laptop only).
SPRING_PROFILES_ACTIVE=local
AWS_ENDPOINT=http://localstack:4566
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@convoy.test
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost
COOKIE_SECURE=false
SEED_USERS_FILE=/seed/users.json
IMAGE_IDENTITY=convoy-identity
IMAGE_GATEWAY=convoy-gateway
IMAGE_CATALOG=convoy-catalog
IMAGE_DEALER=convoy-dealer
IMAGE_POOL=convoy-pool
IMAGE_QUOTE=convoy-quote
IMAGE_ORDER=convoy-order
IMAGE_PAYMENT=convoy-payment
IMAGE_REALTIME=convoy-realtime
IMAGE_NOTIFICATION=convoy-notification
IMAGE_AUDIT=convoy-audit
IMAGE_WEB=convoy-web
IMAGE_RAZORPAY_FAKE=convoy-razorpay-fake
IMAGE_DEMO_BOTS=convoy-demo-bots
