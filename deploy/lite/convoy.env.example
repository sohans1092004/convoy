# /opt/convoy/convoy.env on the lite host (chmod 600, owner deploy). Never committed. Values from:
#   scripts/dev-env.sh style random secrets (openssl rand -base64 24), infra/aws/shared outputs, infra/oci outputs.
SPRING_PROFILES_ACTIVE=prod
SITE_ADDRESS=convoy-demo.duckdns.org
PUBLIC_URL=https://convoy-demo.duckdns.org
DUCKDNS_DOMAIN=convoy-demo
DUCKDNS_TOKEN=

# AWS (infra/aws/shared outputs): the host user's key, the account, buckets, SES SMTP
AWS_REGION=ap-southeast-2
AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EXPORT_BUCKET=
EVIDENCE_BUCKET=
SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
EMAIL_SIGN_IN=false

# Backups (infra/oci output backup_par_url) and the age PUBLIC key (the private key stays on your laptop)
BACKUP_PAR_URL=
AGE_RECIPIENT=age1...

# Database and service secrets: random, generated once
POSTGRES_PASSWORD=
DB_PASSWORD_IDENTITY=
DB_PASSWORD_CATALOG=
DB_PASSWORD_POOL=
DB_PASSWORD_DEALER=
DB_PASSWORD_QUOTE=
DB_PASSWORD_ORDER=
DB_PASSWORD_PAYMENT=
DB_PASSWORD_REALTIME=
DB_PASSWORD_NOTIFICATION=
DB_PASSWORD_AUDIT=
DB_PASSWORD_AUDIT_OWNER=
IDENTITY_DATA_KEY=
CLIENT_SECRET_GATEWAY=
CLIENT_SECRET_REALTIME=
CLIENT_SECRET_POOL=
CLIENT_SECRET_ORDER=
CLIENT_SECRET_NOTIFICATION=
CLIENT_SECRET_CATALOG=
CLIENT_SECRET_DEALER=
CLIENT_SECRET_QUOTE=
CLIENT_SECRET_PAYMENT=
CLIENT_SECRET_DEMO_BOTS=

# Simulated payments (the built-in fake, P6.B): any random values; never real Razorpay keys on the public demo
RAZORPAY_KEY_ID=rzp_test_fake
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
