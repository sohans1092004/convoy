    "event_type": {
      "const": "PoolBookingStarted"
    },
    "schema_version": {
      "const": 1
    },
    "producer": {
      "const": "pool"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bookings_count",
        "pool_id"
      ],
      "properties": {
        "pool_id": {
          "type": "string",
          "format": "uuid"
        },
        "bookings_count": {
          "type": "integer"
        }
      }
    }
  }
}
