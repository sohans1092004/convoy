{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convoy.example/schemas/events/RefundFailed.schema.json",
  "title": "RefundFailed v1",
  "description": "Owner: payment. Consumers: notification, audit. FIFO: False.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "RefundFailed"
    },
    "schema_version": {
      "const": 1
    },
    "producer": {
      "const": "payment"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "failure_reason",
        "payment_id",
        "refund_id"
      ],
      "properties": {
        "refund_id": {
          "type": "string",
          "format": "uuid"
        },
        "payment_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempts": {
          "type": "integer"
        },
        "failure_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
