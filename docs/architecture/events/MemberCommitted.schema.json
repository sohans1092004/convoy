{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convoy.example/schemas/events/MemberCommitted.schema.json",
  "title": "MemberCommitted v1",
  "description": "Owner: pool. Consumers: realtime, notification, audit. FIFO: True.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "MemberCommitted"
    },
    "schema_version": {
      "const": 1
    },
    "producer": {
      "const": "pool"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_id",
        "committed_count",
        "interested_count",
        "kept_from_previous_round",
        "membership_id",
        "payment_id",
        "pool_id"
      ],
      "properties": {
        "pool_id": {
          "type": "string",
          "format": "uuid"
        },
        "membership_id": {
          "type": "string",
          "format": "uuid"
        },
        "buyer_id": {
          "type": "string",
          "format": "uuid"
        },
        "payment_id": {
          "type": "string",
          "format": "uuid"
        },
        "interested_count": {
          "type": "integer"
        },
        "committed_count": {
          "type": "integer"
        },
        "kept_from_previous_round": {
          "type": "boolean"
        }
      }
    }
  }
}
