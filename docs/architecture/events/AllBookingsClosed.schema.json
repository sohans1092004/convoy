{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convoy.example/schemas/events/AllBookingsClosed.schema.json",
  "title": "AllBookingsClosed v1",
  "description": "Owner: order. Consumers: pool, audit. FIFO: False.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "AllBookingsClosed"
    },
    "schema_version": {
      "const": 1
    },
    "producer": {
      "const": "order"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancelled",
        "delivered",
        "pool_id"
      ],
      "properties": {
        "pool_id": {
          "type": "string",
          "format": "uuid"
        },
        "delivered": {
          "type": "integer"
        },
        "cancelled": {
          "type": "integer"
        }
      }
    }
  }
}
