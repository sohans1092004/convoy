{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convoy.example/schemas/events/UserRegistered.schema.json",
  "title": "UserRegistered v1",
  "description": "Owner: identity. Consumers: notification, audit. FIFO: False.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "UserRegistered"
    },
    "schema_version": {
      "const": 1
    },
    "producer": {
      "const": "identity"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "roles",
        "user_id"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "locale": {
          "type": "string",
          "enum": [
            "en",
            "hi"
          ]
        }
      }
    }
  }
}
