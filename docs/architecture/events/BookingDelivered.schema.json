{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convoy.example/schemas/events/BookingDelivered.schema.json",
  "title": "BookingDelivered v1",
  "description": "Owner: order. Consumers: payment, dealer, realtime, notification, audit. FIFO: False.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "BookingDelivered"
    },
    "schema_version": {
      "const": 1
    },
    "producer": {
      "const": "order"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "booking_id",
        "buyer_id",
        "dealership_id",
        "delivered_at",
        "order_id"
      ],
      "properties": {
        "booking_id": {
          "type": "string",
          "format": "uuid"
        },
        "order_id": {
          "type": "string",
          "format": "uuid"
        },
        "dealership_id": {
          "type": "string",
          "format": "uuid"
        },
        "buyer_id": {
          "type": "string",
          "format": "uuid"
        },
        "delivered_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC, RFC 3339"
        }
      }
    }
  }
}
