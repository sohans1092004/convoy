{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convoy.example/schemas/events/ConfirmationRecorded.schema.json",
  "title": "ConfirmationRecorded v1",
  "description": "Owner: order. Consumers: realtime, notification, audit. FIFO: False.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "ConfirmationRecorded"
    },
    "schema_version": {
      "const": 1
    },
    "producer": {
      "const": "order"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed_at",
        "order_id",
        "pool_id",
        "quote_confirmed_count",
        "quote_id"
      ],
      "properties": {
        "order_id": {
          "type": "string",
          "format": "uuid"
        },
        "pool_id": {
          "type": "string",
          "format": "uuid"
        },
        "quote_id": {
          "type": "string",
          "format": "uuid"
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC, RFC 3339"
        },
        "quote_confirmed_count": {
          "type": "integer"
        }
      }
    }
  }
}
