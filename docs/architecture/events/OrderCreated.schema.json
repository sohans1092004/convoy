{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convoy.example/schemas/events/OrderCreated.schema.json",
  "title": "OrderCreated v1",
  "description": "Owner: order. Consumers: realtime, notification, audit. FIFO: False.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "OrderCreated"
    },
    "schema_version": {
      "const": 1
    },
    "producer": {
      "const": "order"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_id",
        "ceiling_cash_payable_paise",
        "ceiling_snapshot_sha256",
        "confirmation_deadline",
        "order_id",
        "pool_id",
        "quote_id",
        "variant_id"
      ],
      "properties": {
        "order_id": {
          "type": "string",
          "format": "uuid"
        },
        "pool_id": {
          "type": "string",
          "format": "uuid"
        },
        "buyer_id": {
          "type": "string",
          "format": "uuid"
        },
        "quote_id": {
          "type": "string",
          "format": "uuid"
        },
        "variant_id": {
          "type": "string",
          "format": "uuid"
        },
        "ceiling_cash_payable_paise": {
          "type": "integer",
          "minimum": 0,
          "description": "Money in integer paise (ADR-012)"
        },
        "ceiling_snapshot_sha256": {
          "type": "string",
          "minLength": 1
        },
        "confirmation_deadline": {
          "type": "string",
          "format": "date-time",
          "description": "UTC, RFC 3339"
        }
      }
    }
  }
}
