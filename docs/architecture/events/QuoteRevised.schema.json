{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convoy.example/schemas/events/QuoteRevised.schema.json",
  "title": "QuoteRevised v1",
  "description": "Owner: quote. Consumers: realtime, notification, audit. FIFO: False.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "QuoteRevised"
    },
    "schema_version": {
      "const": 1
    },
    "producer": {
      "const": "quote"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "committed_at",
        "dealership_id",
        "pool_id",
        "quote_id",
        "snapshot_sha256",
        "version_no"
      ],
      "properties": {
        "quote_id": {
          "type": "string",
          "format": "uuid"
        },
        "pool_id": {
          "type": "string",
          "format": "uuid"
        },
        "dealership_id": {
          "type": "string",
          "format": "uuid"
        },
        "version_no": {
          "type": "integer"
        },
        "snapshot_sha256": {
          "type": "string",
          "minLength": 1
        },
        "committed_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC, RFC 3339"
        }
      }
    }
  }
}
