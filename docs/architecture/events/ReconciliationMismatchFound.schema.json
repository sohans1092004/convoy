        "payment_id",
        "refund_id",
        "run_id"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "mismatch_class": {
          "type": "string",
          "minLength": 1
        },
        "payment_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "refund_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
