{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convoy.example/schemas/events/QuoteFinalised.schema.json",
  "title": "QuoteFinalised v1",
  "description": "Owner: quote. Consumers: pool, order, realtime, notification, audit. FIFO: False.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "QuoteFinalised"
    },
    "schema_version": {
      "const": 1
    },
    "producer": {
      "const": "quote"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dealership_id",
        "final_version_no",
        "max_units",
        "min_fulfilment",
        "pool_id",
        "quote_id",
        "ruleset_version",
        "snapshot_sha256",
        "tiers",
        "variant_ids",
        "variant_inputs"
      ],
      "properties": {
        "quote_id": {
          "type": "string",
          "format": "uuid"
        },
        "pool_id": {
          "type": "string",
          "format": "uuid"
        },
        "dealership_id": {
          "type": "string",
          "format": "uuid"
        },
        "final_version_no": {
          "type": "integer"
        },
        "variant_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "min_fulfilment": {
          "type": "integer"
        },
        "max_units": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_sha256": {
          "type": "string",
          "minLength": 1
        },
        "ruleset_version": {
          "type": "string",
          "minLength": 1
        },
        "tiers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "variant_inputs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
