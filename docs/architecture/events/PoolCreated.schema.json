{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convoy.example/schemas/events/PoolCreated.schema.json",
  "title": "PoolCreated v1",
  "description": "Owner: pool. Consumers: realtime, notification, audit. FIFO: True.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "PoolCreated"
    },
    "schema_version": {
      "const": 1
    },
    "producer": {
      "const": "pool"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_variant_ids",
        "city",
        "forming_deadline",
        "min_members",
        "model_id",
        "pool_id",
        "purchase_window_end",
        "state"
      ],
      "properties": {
        "pool_id": {
          "type": "string",
          "format": "uuid"
        },
        "model_id": {
          "type": "string",
          "format": "uuid"
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "min_members": {
          "type": "integer"
        },
        "forming_deadline": {
          "type": "string",
          "format": "date-time",
          "description": "UTC, RFC 3339"
        },
        "purchase_window_end": {
          "type": "string",
          "format": "date-time",
          "description": "UTC, RFC 3339"
        },
        "accepted_variant_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
