{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convoy.example/schemas/events/MemberLeft.schema.json",
  "title": "MemberLeft v1",
  "description": "Owner: pool. Consumers: payment, realtime, audit. FIFO: True.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "MemberLeft"
    },
    "schema_version": {
      "const": 1
    },
    "producer": {
      "const": "pool"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_id",
        "committed_count",
        "interested_count",
        "membership_id",
        "payment_id",
        "pool_id",
        "reason"
      ],
      "properties": {
        "pool_id": {
          "type": "string",
          "format": "uuid"
        },
        "membership_id": {
          "type": "string",
          "format": "uuid"
        },
        "buyer_id": {
          "type": "string",
          "format": "uuid"
        },
        "payment_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "BUYER_LEFT"
          ]
        },
        "interested_count": {
          "type": "integer"
        },
        "committed_count": {
          "type": "integer"
        }
      }
    }
  }
}
