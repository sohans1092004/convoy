{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convoy.example/schemas/events/CatalogPriceUpdated.schema.json",
  "title": "CatalogPriceUpdated v1",
  "description": "Owner: catalog. Consumers: quote, notification, audit. FIFO: False.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "CatalogPriceUpdated"
    },
    "schema_version": {
      "const": 1
    },
    "producer": {
      "const": "catalog"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "city",
        "effective_from",
        "evidence",
        "ex_showroom_paise",
        "source_url",
        "variant_id"
      ],
      "properties": {
        "variant_id": {
          "type": "string",
          "format": "uuid"
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "ex_showroom_paise": {
          "type": "integer",
          "minimum": 0,
          "description": "Money in integer paise (ADR-012)"
        },
        "evidence": {
          "type": "string",
          "enum": [
            "DEALER_CONFIRMED",
            "CATALOGUE_ESTIMATE",
            "UNVERIFIED"
          ]
        },
        "effective_from": {
          "type": "string",
          "format": "date",
          "description": "Calendar date in IST"
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
