{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convoy.example/schemas/events/ErasureRequested.schema.json",
  "title": "ErasureRequested v1",
  "description": "Owner: identity. Consumers: catalog, pool, dealer, quote, order, payment, notification, audit. FIFO: False.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "ErasureRequested"
    },
    "schema_version": {
      "const": 1
    },
    "producer": {
      "const": "identity"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "erasure_id",
        "requested_at",
        "user_id"
      ],
      "properties": {
        "erasure_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC, RFC 3339"
        }
      }
    }
  }
}
