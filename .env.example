# Copy to .env (git-ignored) and fill in. `scripts/dev-env.sh` generates random local values for
# everything except the Razorpay keys. Never commit real values.

# Postgres superuser (container init only) and one password per service role
POSTGRES_PASSWORD=
DB_PASSWORD_IDENTITY=
DB_PASSWORD_CATALOG=
DB_PASSWORD_POOL=
DB_PASSWORD_DEALER=
DB_PASSWORD_QUOTE=
DB_PASSWORD_ORDER=
DB_PASSWORD_PAYMENT=

# identity: base64 of 32 random bytes (email ciphertext + lookup hashes)
IDENTITY_DATA_KEY=

# Service-to-service client secrets (auth-contract.md §5)
CLIENT_SECRET_GATEWAY=
CLIENT_SECRET_POOL=
CLIENT_SECRET_REALTIME=
CLIENT_SECRET_ORDER=
CLIENT_SECRET_NOTIFICATION=
DB_PASSWORD_REALTIME=
DB_PASSWORD_NOTIFICATION=

# Razorpay TEST mode. Leave as-is to use the local fake (tools/razorpay-fake).
# For the manual run against real Razorpay test mode: put your rzp_test_ key id/secret here, set
# RAZORPAY_BASE_URL=https://api.razorpay.com and the webhook secret you configured in the dashboard.
RAZORPAY_BASE_URL=http://razorpay-fake:9090
RAZORPAY_KEY_ID=rzp_test_fake
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Demo durations (minutes) for the walking skeleton; production values are in Q-022.
DEMO_SEALED_ROUND_SECONDS=90
DEMO_FINAL_ROUND_SECONDS=20
DEMO_DECISION_SECONDS=60
DEMO_CONFIRMATION_SECONDS=60
DEMO_REROUND_CHOICE_SECONDS=120
# Demo pool minimum (AMENDMENT-007: production is 5).
POOL_MIN_MEMBERS=1
# Demo environment: seeds the synthetic dealerships (deploy/local/seed/dealerships.sql). Never true in a real environment.
DEMO=true
