{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "paths": {
    "/webhooks/razorpay": {
      "post": {
        "tags": [
          "payment-application"
        ],
        "operationId": "webhook",
        "parameters": [
          {
            "name": "X-Razorpay-Signature",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-razorpay-event-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookAck"
                }
              }
            }
          }
        }
      }
    },
    "/payments/{id}/checkout-callback": {
      "post": {
        "tags": [
          "payment-application"
        ],
        "operationId": "callback",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CallbackBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentView"
                }
              }
            }
          }
        }
      }
    },
    "/internal/deposits": {
      "post": {
        "tags": [
          "payment-application"
        ],
        "operationId": "deposit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DepositBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentView"
                }
              }
            }
          }
        }
      }
    },
    "/me/payments/{id}": {
      "get": {
        "tags": [
          "payment-application"
        ],
        "operationId": "mine",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentView"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "WebhookAck": {
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "CallbackBody": {
        "properties": {
          "razorpay_payment_id": {
            "type": "string",
            "minLength": 1
          },
          "razorpay_order_id": {
            "type": "string",
            "minLength": 1
          },
          "razorpay_signature": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "razorpay_order_id",
          "razorpay_payment_id",
          "razorpay_signature"
        ]
      },
      "PaymentView": {
        "properties": {
          "payment_id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "amount_paise": {
            "type": "integer",
            "format": "int64"
          },
          "currency": {
            "type": "string"
          },
          "razorpay_order_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "razorpay_key_id": {
            "type": "string"
          },
          "test_mode": {
            "type": "boolean"
          }
        },
        "required": [
          "amount_paise",
          "currency",
          "payment_id",
          "razorpay_key_id",
          "razorpay_order_id",
          "state",
          "test_mode"
        ]
      },
      "DepositBody": {
        "properties": {
          "buyer_id": {
            "type": "string",
            "format": "uuid"
          },
          "pool_id": {
            "type": "string",
            "format": "uuid"
          },
          "round_set": {
            "type": "integer",
            "format": "int32"
          },
          "amount_paise": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "amount_paise",
          "buyer_id",
          "pool_id",
          "round_set"
        ]
      }
    }
  }
}
